{
  "name": "kinexus",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply kinexus --local",
    "db:migrate:remote": "wrangler d1 migrations apply kinexus --remote",
    "seed:users": "tsx scripts/generate-user-seed.ts",
    "seed:exercises": "tsx seed/fetch-garmin-catalog.ts",
    "ref:exercises": "tsx scripts/generate-exercise-reference.ts"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.6.0",
    "@cloudflare/workers-types": "^4.20240925.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.80.0"
  }
}
